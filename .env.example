# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
OPENROUTER_API_KEY=
DATABASE_URL=postgresql+asyncpg://relay:relay@localhost:5432/relay
JWT_SECRET=                 # at least 16 chars; `python -c "import secrets;print(secrets.token_urlsafe(48))"`
FERNET_KEY=                 # encrypts OAuth refresh tokens; `python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"`
AWS_REGION=ap-south-1
S3_BUCKET=relay-files
S3_ENDPOINT_URL=            # http://localhost:9000 for MinIO in development; empty for AWS
DEFAULT_MONTHLY_CAP_USD=50
APP_BASE_URL=http://localhost:3000
